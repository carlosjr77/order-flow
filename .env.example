# Order Flow - Configuração para Docker
# Copie este arquivo para .env e ajuste os valores conforme necessário

# ========================
# Database
# ========================
DATABASE_URL=postgresql://orderflow_user:orderflow_password@db:5432/ordem_vendas
SQLALCHEMY_DATABASE_URL=postgresql://orderflow_user:orderflow_password@db:5432/ordem_vendas

# ========================
# JWT/Security
# ========================
JWT_SECRET_KEY=your-secret-key-change-in-production-12345678
SECRET_KEY=your-secret-key-change-in-production-12345678
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ========================
# Admin User
# ========================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ========================
# API
# ========================
API_PORT=8000
FRONTEND_URL=http://localhost:3000

# ========================
# Frontend
# ========================
VITE_API_URL=http://localhost:8000

# ========================
# Environment
# ========================
ENVIRONMENT=development
