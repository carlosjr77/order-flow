ADMIN_PASSWORD=admin123

# ========================
# API
# ========================
API_PORT=8000
FRONTEND_URL=http://localhost:3000

# ========================
# Frontend
# ========================
VITE_API_URL=http://localhost:8000

# ========================
# Environment
# ========================
ENVIRONMENT=development

# ========================
# NF-e (homologação)
# ========================
